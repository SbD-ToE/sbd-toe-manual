  "motivosPorNome": {
    "@planeamento": "«Planeamento» sozinho é o Sprint Planning; o que é da organização (contratos, fornecedores, políticas, formação, ciclos) vai para a Cadência organizacional (caso agil-planeamento-org).",
    "sprint review": "O nome já é o evento (02 US-06).",
    "testes/review": "No cap. 02 a etapa é «Sprint review / Testes» (tabela do ciclo de vida, aplicacao-lifecycle.md l. 30), e o SLA é «Por sprint e antes de release» (02 US-09).",
    "execução": "Decisão fase-execucao: Build e CI e Transversal. Aqui resolve-se linha a linha pelo trigger: execuções de pipeline e jobs vão para o Sprint, as do cap. 14 para a Cadência organizacional."
  },
  "regras": {
    "fluxo-sprint": {
      "descricao": "O trigger ou o SLA falam de PR, merge, commit, pipeline, job, «a cada execução», nova tag ou do sprint corrente: é trabalho do sprint.",
      "campos": [
        "trigger",
